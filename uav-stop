#!/bin/bash

UAV_PID_FILE="$HOME/.cache/uav-terminator.pids"

echo "======================================"
echo "      Stopping UAV Simulation"
echo "======================================"

echo "[1/5] Stopping QGroundControl..."
pkill -TERM -u "$(id -u)" -f '[Q]GroundControl' 2>/dev/null || true

echo "[2/5] Stopping MAVProxy..."
pkill -TERM -u "$(id -u)" -f '[m]avproxy.py' 2>/dev/null || true

echo "[3/5] Stopping ArduPilot SITL..."
pkill -TERM -u "$(id -u)" -f '[b]uild/sitl/bin/arducopter' 2>/dev/null || true
pkill -TERM -u "$(id -u)" -f '[T]ools/autotest/sim_vehicle.py' 2>/dev/null || true

echo "[4/5] Stopping Gazebo..."
pkill -TERM -u "$(id -u)" -f '^gz sim' 2>/dev/null || true

echo ""
echo "Waiting for applications to exit cleanly..."
sleep 3

echo "[5/5] Closing UAV-managed terminal windows..."

if [ -f "$UAV_PID_FILE" ]; then
    while IFS= read -r pid; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue

        cmd=$(ps -p "$pid" -o args= -ww 2>/dev/null) || continue

        if [[ "$cmd" == *"/terminator"* &&
              "$cmd" == *" -u "* &&
              ( "$cmd" == *" -T Gazebo "* ||
                "$cmd" == *" -T ArduPilot SITL "* ) ]]; then
            echo "Closing dedicated Terminator PID: $pid"
            kill -TERM "$pid" 2>/dev/null || true
        fi
    done < "$UAV_PID_FILE"
fi

# Close the ArduCopter xterm created by sim_vehicle.py, if still present.
pkill -TERM -u "$(id -u)" -f '[x]term .* -T ArduCopter' 2>/dev/null || true

sleep 2

echo ""
echo "Cleaning up processes that did not exit..."

pkill -KILL -u "$(id -u)" -f '[Q]GroundControl' 2>/dev/null || true
pkill -KILL -u "$(id -u)" -f '[m]avproxy.py' 2>/dev/null || true
pkill -KILL -u "$(id -u)" -f '[b]uild/sitl/bin/arducopter' 2>/dev/null || true
pkill -KILL -u "$(id -u)" -f '[T]ools/autotest/sim_vehicle.py' 2>/dev/null || true
pkill -KILL -u "$(id -u)" -f '^gz sim' 2>/dev/null || true
pkill -KILL -u "$(id -u)" -f '[x]term .* -T ArduCopter' 2>/dev/null || true

rm -f "$UAV_PID_FILE"

sleep 1

echo ""
echo "Checking for remaining UAV processes..."

if pgrep -af '[g]z sim|[a]rducopter|[m]avproxy.py|[Q]GroundControl|[s]im_vehicle.py|[x]term .* -T ArduCopter'; then
    echo ""
    echo "WARNING: Some UAV processes are still running."
    exit 1
else
    echo "All UAV processes stopped successfully."
fi

echo ""
echo "======================================"
echo " UAV simulation environment stopped."
echo "======================================"
